{
  "name": "nanolist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack && node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs && node scripts/generate-llms.mjs",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "types": "tsc --noEmit",
    "knip": "knip",
    "validate": "tsx scripts/validate-listings.ts && tsx scripts/generate-issue-template.ts --check",
    "generate:issue-template": "tsx scripts/generate-issue-template.ts",
    "fetch-icons": "tsx scripts/fetch-icons.ts",
    "test:lint": "biome lint .",
    "test:format": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "test:types": "tsc --noEmit",
    "test:knip": "knip",
    "test:ava": "ava",
    "test:ava:coverage": "c8 --reporter=text --reporter=json-summary ava",
    "test:audit": "pnpm audit --audit-level=high --ignore-unfixable",
    "test:security": "semgrep scan --config auto --error",
    "test:all": "pnpm run test:format && pnpm run test:lint && pnpm run test:types && pnpm run test:knip && pnpm run validate && pnpm run test:ava:coverage",
    "parse-submission": "tsx scripts/parse-submission.ts"
  },
  "ava": {
    "files": [
      "tests/**/*.test.ts"
    ],
    "extensions": [
      "ts"
    ],
    "workerThreads": false,
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "feed": "^5.1.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.545.0",
    "next": "^15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "knip": "^6.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
